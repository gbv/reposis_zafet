<?xml version="1.0" encoding="UTF-8"?>
<!-- ======================================================= -->
<!-- ========== Template Management Notes ========== -->
<!--
    This XML document modifies and overrides templates from MIR.
    Templates are organized in dedicated sections below:
        1. New
        2. Overrides
        3. Modifications
    Sections are provided for Admin, Host, Genre, and general templates including helper templates.
    Empty sections are avoided to reduce confusion.
    Templates within each section should be sorted alphabetically.
    General new templates should NOT be defined here; they must be placed in a *-editor-includes file.
    Circular references must be avoided to prevent loops or unintended overrides.
-->
<!-- ======================================================= -->
<xed:template xmlns:xed="http://www.mycore.de/xeditor" xmlns:mir="http://www.mycore.de/mir">

  <!-- ========== Admin: Modifications ========== -->
  <xed:modify ref="admin.fields">
    <xed:include ref="projects"                 after="sdnb.repeat" />
    <xed:include ref="collections"                     after="projects" />
    <xed:remove ref="related.item.other.search.of.all.items" />
  </xed:modify>

  <!-- ========== Genre: New ========== -->
  <xed:template id="genres.document">
    <xed:include ref="genres.article" />
  </xed:template>

  <xed:template id="genres.working_paper">
    <xed:include ref="genres.article" />
  </xed:template>

  <!-- ========== Genre: Modifications ========== -->
  <xed:modify ref="genres.av.common">
    <xed:include ref="projects"                 after="sdnb.repeat" />
    <xed:include ref="collections"                     after="projects" />
  </xed:modify>

  <xed:modify ref="genres.book.common">
    <xed:include ref="projects"                 after="sdnb.repeat" />
    <xed:include ref="collections"                     after="projects" />
  </xed:modify>

  <xed:modify ref="genres.entry">
    <xed:include ref="projects"                 after="sdnb.repeat" />
    <xed:include ref="collections"                     after="projects" />
  </xed:modify>

  <xed:modify ref="genres.journal.common">
    <xed:include ref="projects"                 after="sdnb.repeat" />
    <xed:include ref="collections"                     after="projects" />
  </xed:modify>

  <xed:modify ref="genres.lecture">
    <xed:include ref="projects"                 after="sdnb.repeat" />
    <xed:include ref="collections"                     after="projects" />
  </xed:modify>

  <xed:template id="genres.podcast">
    <xed:include ref="type.of.resource.sound_recording" />
    <xed:include ref="genres.av.common" />
  </xed:template>

  <xed:modify ref="genres.poster">
    <xed:include ref="projects"                 after="sdnb.repeat" />
    <xed:include ref="collections"                     after="projects" />
  </xed:modify>

  <xed:modify ref="genres.preface">
    <xed:include ref="projects"                 after="sdnb.repeat" />
    <xed:include ref="collections"                     after="projects" />
  </xed:modify>

  <xed:modify ref="genres.publication.common">
    <xed:include ref="projects"                 after="sdnb.repeat" />
    <xed:include ref="collections"                     after="projects" />
  </xed:modify>

  <xed:modify ref="genres.report.common">
    <xed:include ref="projects"                 after="sdnb.repeat" />
    <xed:include ref="collections"                     after="projects" />
  </xed:modify>

  <xed:modify ref="genres.research_data">
    <xed:include ref="projects"                 after="sdnb.repeat" />
    <xed:include ref="collections"                     after="projects" />
  </xed:modify>

  <xed:modify ref="genres.speech">
    <xed:include ref="projects"                 after="sdnb.repeat" />
    <xed:include ref="collections"                     after="projects" />
  </xed:modify>

  <xed:modify ref="genres.teaching_material">
    <xed:include ref="projects"                 after="sdnb.repeat" />
    <xed:include ref="collections"                     after="projects" />
  </xed:modify>

  <xed:modify ref="genres.thesis.common">
    <xed:include ref="projects"                 after="sdnb.repeat" />
    <xed:include ref="collections"                     after="projects" />
  </xed:modify>

</xed:template>
